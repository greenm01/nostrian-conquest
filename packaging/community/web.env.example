NC_GAMES_ROOT=/srv/nc/community/games
NC_PUBLIC_ORIGIN=https://play.example.net
NC_BRIDGE_HOST=127.0.0.1
NC_BRIDGE_PORT=8082
NC_BRIDGE_DOOR_BINARY=/opt/nc-community/current/bin/nc-door
NC_BRIDGE_STATIC_DIR=/opt/nc-community/current/static
NC_BRIDGE_MAX_NODES=16
NC_DISCORD_CLIENT_ID=REPLACE
NC_DISCORD_CLIENT_SECRET=REPLACE
# Optional one-click Matrix sign-in; register the client as described in
# docs/dev/community-hosting.md. Set both, or leave both absent.
# NC_MATRIX_OAUTH_CLIENT_ID=REPLACE
# NC_MATRIX_OAUTH_CLIENT_SECRET=REPLACE
# Relays asked for Nostr profile names at sign-in (comma-separated; this is the default).
# NC_NOSTR_PROFILE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
