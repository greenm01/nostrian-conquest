// The default style (t167): ETACs with escorts and scouts before garrisons,
// war late, and strikes at nearly four times a target's estimated defence.
// Retuned under t206's cover rules with mixed hulls: cruisers and destroyers
// in about equal weight, no battleships in the line. Spare transports
// ferry armies to threatened colonies (t191), and strikes blitz worlds whose
// batteries are known gone (t207). Idle warships join a strike force that
// falls short of its target (t207). These are `Weights::TUNED`.
personality "land-grab"
weights {
    tax 62.702686
    home-armies 20.0
    colony-armies 9.745128
    batteries 9.870895
    etacs 6.282104
    scouts 0.21374373
    starbases 0.44496453
    transports 13.457997
    battleship 0.0
    cruiser 0.26427263
    destroyer 0.3204773
    attack-ratio 3.742486
    roe 4.784798
    war-year 24.076294
    young-tax 62.702686
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #false
    supply #true
    defend #true
    mixed-hulls #true
    keep-scouts #true
    watch #true
    forward-muster #true
    pickets #false
    ferry #true
    blitz #true
    reinforce #true
    colony-starbases #true
}
// Tuning keeps the style: maximal early expansion and a long horizon.
bounds {
    etacs 2.5 8.0
    war-year 12.0 30.0
    battleship 0.0 0.0
    destroyer 0.1 1.0
}
