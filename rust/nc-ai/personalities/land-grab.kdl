// The default style (t167): ETACs with escorts and scouts before garrisons,
// war late, and strikes at nearly four times a target's estimated defence
// (retuned under t202's planetary rules). These are `Weights::TUNED`.
personality "land-grab"
weights {
    tax 65.0
    home-armies 18.272446
    colony-armies 9.787356
    batteries 10.0
    etacs 5.739257
    scouts 1.3849299
    starbases 1.9544523
    transports 15.680258
    battleship 0.36343873
    cruiser 0.8007311
    destroyer 0.0036436752
    attack-ratio 3.801882
    roe 6.3801665
    war-year 17.86982
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #false
    supply #true
    defend #true
    mixed-hulls #false
    reinforce #false
    combined-gate #false
    keep-scouts #true
    watch #true
    forward-muster #true
}
// Tuning keeps the style: maximal early expansion and a long horizon.
bounds {
    etacs 2.5 8.0
    war-year 12.0 30.0
}
