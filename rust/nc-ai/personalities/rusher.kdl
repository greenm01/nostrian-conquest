// The rusher (t167): war from the first years, few ETACs, and strikes below
// a target's estimated defence. Retuned under t255's per-hull fire with
// mixed hulls (t256): destroyers ahead of cruisers, no battleships in the
// line.
personality "rusher"
weights {
    tax 62.95915
    home-armies 19.154161
    colony-armies 9.623967
    batteries 6.839994
    etacs 2.823832
    scouts 4.6312447
    starbases 1.4676801
    transports 14.328641
    battleship 0.0
    cruiser 0.4993522
    destroyer 0.732177
    attack-ratio 0.91970015
    roe 4.7039447
    war-year 1.5348958
    young-tax 20.991535
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #false
    supply #true
    defend #true
    mixed-hulls #true
    keep-scouts #true
    watch #true
    forward-muster #true
    pickets #false
    ferry #false
    blitz #false
    reinforce #false
    colony-starbases #false
    repair-at-bases #false
}
// Tuning keeps the style: early war, low odds to attack, little expansion.
bounds {
    battleship 0.0 0.0
    destroyer 0.1 1.0
    etacs 0.0 3.0
    attack-ratio 0.5 1.0
    war-year 0.0 3.0
}
// A learned rusher strikes with everything (t175's allocation 0).
goals {
    allocation 0 0
}
