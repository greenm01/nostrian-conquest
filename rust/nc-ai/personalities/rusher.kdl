// The rusher (t167): war from the first years, few ETACs, and strikes below
// a target's estimated defence. Retuned under t206's cover rules with mixed
// hulls: cruisers and destroyers, no battleships in the line.
personality "rusher"
weights {
    tax 63.88718
    home-armies 20.0
    colony-armies 8.588767
    batteries 9.667504
    etacs 2.5013711
    scouts 1.6963803
    starbases 0.09892445
    transports 12.222214
    battleship 0.0
    cruiser 0.56069237
    destroyer 0.4539108
    attack-ratio 0.7930259
    roe 4.8970838
    war-year 2.1730373
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #false
    supply #true
    defend #true
    mixed-hulls #true
    keep-scouts #true
    watch #true
    forward-muster #true
    pickets #false
}
// Tuning keeps the style: early war, low odds to attack, little expansion.
bounds {
    battleship 0.0 0.0
    destroyer 0.1 1.0
    etacs 0.0 3.0
    attack-ratio 0.5 1.0
    war-year 0.0 3.0
}
// A learned rusher strikes with everything (t175's allocation 0).
goals {
    allocation 0 0
}
