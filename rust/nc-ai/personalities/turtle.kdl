// The turtle (t167): strong garrisons, batteries and starbases, war late,
// and strikes only at long odds. It holds back fleet for defence by threat
// (t175's allocation rule).
personality "turtle"
weights {
    tax 63.33496
    home-armies 20.0
    colony-armies 9.561666
    batteries 9.835596
    etacs 5.6055384
    scouts 0.0
    starbases 2.7356834
    transports 16.0
    battleship 0.7157012
    cruiser 0.9378893
    destroyer 0.0
    attack-ratio 3.8172789
    roe 6.0378585
    war-year 27.38407
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #true
    supply #true
    defend #true
    mixed-hulls #false
    keep-scouts #true
    watch #true
    forward-muster #true
    pickets #false
    ferry #false
    blitz #false
}
// Tuning keeps the style: full garrisons and batteries, starbases, late war
// and long odds.
bounds {
    colony-armies 8.0 10.0
    batteries 8.0 10.0
    starbases 2.0 3.0
    attack-ratio 3.0 4.0
    war-year 24.0 30.0
}
// A learned turtle always guards threatened worlds (t175's allocation 1 or
// 2), whatever its network would choose.
goals {
    allocation 1 2
}
