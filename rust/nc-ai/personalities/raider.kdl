// The raider (t189): cheap, fast destroyers first, striking at short odds.
// Colonies and the home world build destroyers; the fleet moves at speed 6.
// Retuned under t255's per-hull fire (t256): a later war and more cruisers.
personality "raider"
weights {
    tax 63.51344
    home-armies 15.248486
    colony-armies 9.946619
    batteries 10.0
    etacs 4.357539
    scouts 4.711386
    starbases 0.84327984
    transports 13.532373
    battleship 0.1428313
    cruiser 0.5604862
    destroyer 0.903755
    attack-ratio 1.568236
    roe 4.100554
    war-year 14.20052
    young-tax 58.97051
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #false
    supply #true
    defend #true
    mixed-hulls #false
    keep-scouts #true
    watch #true
    forward-muster #true
    pickets #false
    ferry #false
    blitz #false
    reinforce #false
    colony-starbases #false
    repair-at-bases #false
    etac-share #true
    salvage-etacs #true
}
// Tuning keeps the style: destroyers preferred, short odds, early-ish war.
bounds {
    battleship 0.0 0.3
    cruiser 0.0 0.6
    destroyer 0.85 1.0
    attack-ratio 1.0 2.0
    war-year 6.0 22.0
}
