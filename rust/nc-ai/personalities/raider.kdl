// The raider (t189): cheap, fast destroyers first, striking at short odds.
// Colonies and the home world build destroyers; the fleet moves at speed 6.
personality "raider"
weights {
    tax 63.545086
    home-armies 16.938251
    colony-armies 9.6966095
    batteries 10.0
    etacs 8.0
    scouts 1.3695203
    starbases 1.0171384
    transports 15.615639
    battleship 0.056925546
    cruiser 0.21824437
    destroyer 0.9800827
    attack-ratio 1.7594712
    roe 4.715693
    war-year 6.0
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #false
    supply #true
    defend #true
    mixed-hulls #false
    keep-scouts #true
    watch #true
    forward-muster #true
    pickets #false
    ferry #false
    blitz #false
}
// Tuning keeps the style: destroyers preferred, short odds, early-ish war.
bounds {
    battleship 0.0 0.3
    cruiser 0.0 0.6
    destroyer 0.85 1.0
    attack-ratio 1.0 2.0
    war-year 6.0 22.0
}
