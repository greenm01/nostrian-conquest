// The armada (t189): slow capital ships first. The home world builds
// battleships whenever its budget buys one (colonies build cruisers), and the
// fleet gathers before it strikes. Everything else is the default style.
personality "armada"
weights {
    tax 64.7396
    home-armies 19.398222
    colony-armies 8.905036
    batteries 10.0
    etacs 7.313471
    scouts 0.21400934
    starbases 0.16797093
    transports 15.98223
    battleship 0.87965643
    cruiser 0.1293266
    destroyer 0.07113293
    attack-ratio 3.303628
    roe 4.3846607
    war-year 25.792002
}
doctrine {
    land-grab #true
    strike-weakest #true
    suppress-first #true
    scaled-garrisons #true
    blockader #true
    allocate #false
    supply #true
    defend #true
    mixed-hulls #false
    reinforce #false
    combined-gate #false
    keep-scouts #true
    watch #true
    forward-muster #true
    pickets #false
}
// Tuning keeps the style: battleships preferred, expansion unchanged.
bounds {
    battleship 0.85 1.0
    cruiser 0.0 0.6
    destroyer 0.0 0.2
    etacs 2.5 8.0
    war-year 12.0 30.0
}
