// Nostrian Conquest: a game's settings (config.kdl in the game directory).
// nc-sysop new-game writes one with these defaults. Edits take effect at the
// next login or maintenance run, and players get a Game Notice listing the
// changes. The seat count, seed and map size are set by new-game and are not
// in this file.
game_name "Nostrian Conquest"
theme "tokyo_night"
snoop #true
session {
    max_idle_minutes 10
    minimum_time_minutes 0
    local_timeout #false
    remote_timeout #true
}
inactivity {
    // Put an empire on autopilot after this many missed turns; 0 never does.
    autopilot_after_turns 3
}
maintenance {
    enabled #false
    interval_minutes 1440
}
